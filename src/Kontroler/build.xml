<?xml version="1.0" encoding="UTF-8"?>
<project name="IO" basedir="../.." default="run">
	<property name="classes.dir" value="build/classes"/>
	<target name="clean"><delete dir="${classes.dir}"/></target>
	<target name="build">
		<mkdir dir="${classes.dir}"/>
		<javac srcdir="src" destdir="${classes.dir}" source="8" target="8" encoding="UTF-8" includeantruntime="false"/>
	</target>
	<target name="run" depends="build">
		<java classname="Kontroler.Main" classpath="${classes.dir}" fork="true"/>
	</target>
</project>
