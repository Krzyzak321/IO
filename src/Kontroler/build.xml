<?xml version="1.0" encoding="UTF-8"?>
<project name="IO" basedir="." default="run">
	<property name="classes.dir" value="classes"/>
	<path id="build.classpath">
		<pathelement location="${classes.dir}"/>
	</path>

	<target name="clean">
		<delete dir="${classes.dir}"/>
	</target>

	<target name="build">
		<mkdir dir="${classes.dir}"/>
		<javac srcdir=".." destdir="${classes.dir}" source="8" target="8" encoding="UTF-8" includeantruntime="false">
			<include name="Kontroler/**/*.java"/>
		</javac>
	</target>

	<target name="run" depends="build">
		<java classname="Kontroler.Main" classpathref="build.classpath" fork="true"/>
	</target>
</project>
